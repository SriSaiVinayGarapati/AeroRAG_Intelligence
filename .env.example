# =====================================================================
# AeroRAG Intelligence Application - Environment Variables Template
# =====================================================================
# Copy this file to .env and populate with your own API keys:
# cp .env.example .env

# Euron / Euri API Key (Used for multimodal embedding & Gemini 2.5 Pro)
EURI_API_KEY="your_euri_api_key_here"

# Groq API Key (Used for Groq Vision models e.g., LLaMA-4 Scout)
GROQ_API_KEY="your_groq_api_key_here"

# Optional / Alternative Providers
GOOGLE_API_KEY="your_google_api_key_here"
OPENAI_API_KEY="your_openai_api_key_here"
HF_API_KEY="your_huggingface_api_key_here"
COHERE_API_KEY="your_cohere_api_key_here"

# Qdrant Vector Database Configuration
QDRANT_HOST="localhost"
QDRANT_PORT=6333
QDRANT_COLLECTION_NAME="mig_26_images"

